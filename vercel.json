{
  "buildCommand": "cd public-site && npm run build",
  "outputDirectory": "public-site/dist",
  "installCommand": "cd backend && npm install --production && cd ../public-site && npm install --include=dev",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    {
      "source": "/home/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|Slack-ImgProxy|LinkedInBot|TelegramBot|Discordbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
